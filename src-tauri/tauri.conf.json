{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tanzakoo",
  "version": "0.1.0",
  "identifier": "dev.huruikagi.tanzakoo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Tanzakoo", "width": 1500, "height": 940, "minWidth": 1000, "minHeight": 680 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
