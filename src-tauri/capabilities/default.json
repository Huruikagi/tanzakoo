{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tanzakoo main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://huruikagi.github.io/tanzakoo/privacy-ja.html" },
        { "url": "https://huruikagi.github.io/tanzakoo/privacy-en.html" },
        { "url": "https://huruikagi.github.io/tanzakoo/support.html" },
        { "url": "https://www.antigravity.google/docs/ide/extensions/zed" },
        {
          "url": "https://github.com/agentclientprotocol/registry/blob/main/antigravity-acp/agent.json"
        },
        { "url": "https://www.antigravity.google/docs/cli/install/" },
        { "url": "https://docs.github.com/en/copilot/get-started/cli-quickstart" },
        { "url": "https://opencode.ai/docs/" },
        { "url": "https://docs.devin.ai/" }
      ]
    }
  ]
}
