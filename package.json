{
  "name": "tanzakoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "runtime:stage": "node scripts/stage-runtime.mjs",
    "build:desktop": "tauri build --config src-tauri/tauri.runtime.conf.json --no-bundle",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:runtime": "node --test scripts/reference-runtime.test.mjs",
    "test:review": "cargo build --manifest-path src-tauri/Cargo.toml --locked && pnpm --filter @tanzakoo/review-relay test && node --test scripts/review-connection.test.mjs",
    "check": "pnpm lint && pnpm fmt:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "diff": "9.0.0",
    "lucide-react": "1.47.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.13.3",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.81.1",
    "@agentclientprotocol/codex-acp": "1.13.1",
    "@shadcn/lint": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
